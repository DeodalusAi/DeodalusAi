{
  "title": "DaedalusOS Overview",
  "uid": "daedalus-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Self-Healing Success Rate",
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 0},
      "targets": [{"expr": "100 * sum(rate(daedalus_test_runs_total{status=\"passed\"}[15m])) / clamp_min(sum(rate(daedalus_test_runs_total[15m])), 1)", "legendFormat": "passed %"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Agent Latency",
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 0},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, node_name) (rate(daedalus_node_duration_seconds_bucket[5m])))", "legendFormat": "{{node_name}} p95"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Pytest Results",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 5},
      "targets": [{"expr": "sum by (status) (increase(daedalus_test_runs_total[1h]))", "legendFormat": "{{status}}"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "LLM Token Usage",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "targets": [{"expr": "sum by (model, token_type) (rate(daedalus_llm_token_usage_total[5m]))", "legendFormat": "{{model}} {{token_type}}"}],
      "fieldConfig": {"defaults": {"unit": "tokens"}, "overrides": []}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Healing Cycles",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "targets": [{"expr": "increase(daedalus_healing_cycles_total[1h])", "legendFormat": "healing attempts"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    }
  ]
}