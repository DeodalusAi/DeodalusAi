GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
PLANNER_MODEL=gemini-3.5-flash-lite
DEVELOPER_MODEL=groq:qwen/qwen3.8-27b
HEALER_MODEL=groq:qwen/qwen3.8-27b
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MODEL=qwen2.5:7b
LOCAL_LLM_BASE_URL=http://localhost:11434/api/chat
LOCAL_LLM_TIMEOUT_SECONDS=60
LOCAL_LLM_MAX_TOKENS=4000
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
GEMINI_TIMEOUT_SECONDS=15
GROQ_TIMEOUT_SECONDS=8
GROQ_MAX_COMPLETION_TOKENS=12000
LLM_CACHE_TTL_SECONDS=900
LLM_CACHE_SIZE=64
RAG_CACHE_TTL_SECONDS=900
RAG_CACHE_SIZE=128
RAG_MAX_CONTEXT_CHARS=2000
MAG_MEMORY_PATH=sandbox/memory.sqlite3
MAG_MEMORY_TTL_SECONDS=86400
# Build an Ollama model with a LoRA adapter and set LOCAL_LLM_MODEL to that model name.
LOCAL_LLM_ADAPTER=
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_REPO=DeodalusAi/DeodulusAi
GITHUB_BASE_BRANCH=main
QDRANT_URL=https://your-cluster.qdrant.tech
QDRANT_API_KEY=your_qdrant_api_key
PORT=8000